# Copy to .env (or export these directly) and fill in.

# Comma-separated hardverapro.hu search-result URLs to poll.
HA_SEARCH_URLS=https://hardverapro.hu/index.php?st=your+saved+search

# How often to run a full cycle, in seconds. Default 3600 = hourly.
HA_POLL_INTERVAL_SECONDS=3600

# A listing needs at least this many OTHER recent listings of the same
# item before we trust a market reference price enough to flag deals.
# 2 is the floor that still means something (a median of 1 isn't really
# a "market"); most duplicate groups only ever reach 2 others, so 3
# silently discarded most of them.
HA_MIN_SAMPLES=2

# Flag a listing as a deal once it's this fraction below the market
# reference price. 0.20 = 20% below.
HA_DEAL_THRESHOLD=0.20

# How many days of price history feed the rolling reference price.
HA_REFERENCE_WINDOW_DAYS=90

# Ignore listings priced above this (0 = no cap). Useful to exclude
# bundles/lots.
HA_MAX_PRICE=0

HA_DB_PATH=hardverapro_arbitrage.sqlite3
HA_REQUEST_DELAY=2.0
HA_REQUEST_TIMEOUT=15.0

# A category page shows ~100 listings before requiring pagination.
# This follows ?offset=100, ?offset=200, ... up to this many pages per
# category per cycle (1 = old behavior, first page only). This is the
# category browse endpoint's own pagination, not the *search* endpoint's
# that robots.txt disallows, so it's fine to follow -- but each extra
# page is one more request per category per cycle, so weigh this against
# how many categories you're tracking and HA_POLL_INTERVAL_SECONDS.
HA_MAX_PAGES_PER_CATEGORY=3

# Optional Telegram alerts. Leave blank to only log deals to the console.
HA_TELEGRAM_BOT_TOKEN=
HA_TELEGRAM_CHAT_ID=

# --- Web dashboard (`python -m hardverapro_arbitrage --serve` or --all) ---
HA_WEB_HOST=0.0.0.0
HA_WEB_PORT=8765
HA_DEALS_LIST_WINDOW_DAYS=14
HA_DEALS_LIST_LIMIT=200

# --- Retail (árukereső.hu) comparison — secondary to the used-median
# comparison above; see README for why used-median is primary. ---
HA_RETAIL_ENABLED=true

# Flag a listing as a deal vs. retail once it's this far below the
# current lowest new price. Much higher than HA_DEAL_THRESHOLD on
# purpose — nearly every used item is *somewhat* cheaper than new, so
# that alone means nothing; only a big gap does.
HA_RETAIL_DEAL_THRESHOLD=0.45

# A retail product match below this confidence is not trusted at all
# (see retail/matcher.py) — no comparison is made rather than risk
# comparing against the wrong product.
HA_RETAIL_MIN_MATCH_CONFIDENCE=0.6

# Retail prices are cached per item and only re-checked this often.
HA_RETAIL_CACHE_DAYS=7

# Hard cap on retail lookups per scrape cycle, to stay a polite, bounded
# amount of traffic to a site this bot doesn't own. Coverage builds up
# gradually across cycles.
HA_RETAIL_MAX_LOOKUPS_PER_CYCLE=15

HA_RETAIL_REQUEST_DELAY=2.0
HA_RETAIL_REQUEST_TIMEOUT=15.0
