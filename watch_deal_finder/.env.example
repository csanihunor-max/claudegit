# Copy to .env and fill in. Never commit .env.

# Push alerts via ntfy (see README "Phone alerts (ntfy)").
# The topic name is effectively a password on the public server: make it long and random.
NTFY_TOPIC=
# Optional: your own ntfy server and access token. Defaults to the public https://ntfy.sh.
NTFY_SERVER=
NTFY_TOKEN=

# Optional: eBay Browse API (developer.ebay.com -> Application Keys, Production keyset).
# Leave empty to switch eBay off.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
