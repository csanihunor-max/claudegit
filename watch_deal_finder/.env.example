# Copy to .env and fill in. Never commit .env.

# Telegram: create a bot with @BotFather, then see README "Telegram setup".
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: eBay Browse API (developer.ebay.com -> Application Keys, Production keyset).
# Leave empty to switch eBay off.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
